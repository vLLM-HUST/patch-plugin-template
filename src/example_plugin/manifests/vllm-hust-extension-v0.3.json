  "protocols": [
    {
      "name": "vllm.general-plugin",
      "version_range": null
    }
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "example_plugin.plugin",
      "object": "register",
      "status": "active"
    }
  ],
  "requires_services": [],
  "requires_extensions": [],
