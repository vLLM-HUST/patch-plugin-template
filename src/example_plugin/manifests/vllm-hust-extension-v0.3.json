{
  "schema_version": "0.3-experimental",
  "extension_id": "org.vllm-hust.example-plugin",
  "extension_version": "0.1.0.dev0",
  "kind": "in_process_plugin",
  "host": {
    "provider": "vllm",
    "name": "vllm-hust",
    "version_range": ">=0.0,<1.0"
  },
  "runtime": {
    "type": "python",
    "process_scope": "worker",
    "isolation": "trusted_in_process"
