      {
        "group": "vllm.general_plugins",
        "name": "example_plugin"
      }
    ],
    "environment": {
      "VLLM_HUST_EXAMPLE_PLUGIN_ENABLE": "0",
      "VLLM_HUST_EXAMPLE_PLUGIN_KILL_SWITCH": "0",
      "VLLM_HUST_EXAMPLE_PLUGIN_EVIDENCE": "1"
    },
    "additional_config": {
